{
  "name": "fieldwork3d",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "audit:breach-sites": "node --experimental-strip-types scripts/audit-breach-sites.mjs",
    "audit:realism": "node --experimental-strip-types scripts/audit-realism-release.mjs",
