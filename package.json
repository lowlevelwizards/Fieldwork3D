    "preview": "vite preview --host 0.0.0.0"
  },
  "engines": { "node": ">=22" },
  "dependencies": { "three": "^0.180.0" },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
